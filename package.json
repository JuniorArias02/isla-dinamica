{
  "name": "isla-dinamica",
  "version": "1.0.0",
  "private": true,
  "description": "Isla dinámica para GNOME Shell 50",
  "author": "JuniorArias02",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "revisar": "eslint .",
    "corregir": "eslint . --fix",
    "probar": "./pruebas/ejecutar.sh",
    "probar:todo": "./pruebas/ejecutar.sh --aislado",
    "empaquetar": "mkdir -p dist && gnome-extensions pack . --extra-source=modulos --extra-source=recursos --extra-source=LICENSE --schema=schemas/org.gnome.shell.extensions.isla-dinamica.gschema.xml --out-dir=dist --force",
    "probar:paquete": "npm run empaquetar && ./pruebas/aislado/aislado.sh dist/isla-dinamica@juniorarias02.shell-extension.zip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
